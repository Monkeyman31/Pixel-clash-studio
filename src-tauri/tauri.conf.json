{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelClash Studio",
  "version": "2.0.0",
  "identifier": "com.pixelclash.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build -- --base=./",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PixelClash Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "../assets/pixelclash.ico",
      "../assets/pixelclash.png"
    ],
    "fileAssociations": [
      {
        "ext": ["pcs"],
        "name": "Proyecto PixelClash Studio",
        "description": "Archivo de proyecto PixelClash Studio (.pcs)",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installMode": "both"
      }
    }
  }
}
